<?xml version="1.0" encoding="utf-8"?><!--
   API 30 이하 기기의 자동 백업 규칙.
   (API 31+ 는 data_extraction_rules.xml 이 적용된다)
-->
<full-backup-content>
    <!-- JWT access/refresh 토큰(DataStore: pinq_session)은 장기 자격증명이므로
         클라우드 백업에 포함시키지 않는다. 복원 후에는 다시 로그인하면 된다. -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
