<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ 기기의 클라우드 백업/기기 간 전송 규칙.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- JWT access/refresh 토큰(DataStore: pinq_session)은 장기 자격증명이므로
             클라우드 백업에서 제외한다. -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <!-- 기기 간 직접 전송에서도 토큰은 옮기지 않는다 — 새 기기에서 재로그인. -->
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
