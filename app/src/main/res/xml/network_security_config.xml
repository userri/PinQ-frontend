<?xml version="1.0" encoding="utf-8"?>
<!--
  운영 네트워크 보안 정책 — 평문 HTTP 전면 차단.

  개발 중 로컬 백엔드(http://localhost, LAN IP)에 붙어야 할 때는
  debug 소스셋(app/src/debug/res/xml/network_security_config.xml)의
  설정이 이 파일을 대체하므로 여기를 수정할 필요가 없다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
