<?xml version="1.0" encoding="utf-8"?>
<!--
  경제잔디 Design Tokens (XML) — 단일 다크 네이비 테마

  ⚠️ 드로어블/테마에서 hex 를 직접 쓰지 말고 반드시 아래 역할 토큰을 참조할 것.
     Compose 쪽 대응 정의는 ui/theme/Color.kt 에 있다. 두 파일의 값은 항상 같이 바꾼다.
-->
<resources>
    <!-- 배경 계층 (어두운 순) -->
    <color name="bg_base">#FF081A2E</color>
    <color name="bg_surface">#FF0E2540</color>
    <color name="bg_elevated">#FF16385C</color>
    <color name="bg_subtle">#FF1E4470</color>

    <!-- 텍스트 (순백 금지) -->
    <color name="text_primary">#FFF4F7FB</color>
    <color name="text_secondary">#FFB8C7DA</color>
    <color name="text_muted">#FF7E93AC</color>

    <!-- 브랜드 -->
    <color name="lime">#FFAEF23C</color>
    <color name="on_lime">#FF0E2540</color>

    <!-- 잔디 램프 (그리드 전용, 5단계) -->
    <color name="grass_empty">@color/bg_elevated</color>
    <color name="grass_1">#FF124A2E</color>
    <color name="grass_2">#FF1E7A42</color>
    <color name="grass_3">#FF3ECF63</color>
    <color name="grass_max">@color/lime</color>

    <!-- 기타 -->
    <color name="outline">#FF2A4A6E</color>
    <color name="error">#FFFF6B6B</color>
    <color name="error_faint">#FF4A2530</color>
    <!-- 성공 = lime 재사용 (별도 초록 만들지 않는다) -->
    <color name="success">@color/lime</color>

    <!-- 런처/로고 아이콘 글로우 (라임, 알파 포함) -->
    <color name="accent_glow_strong">#3DAEF23C</color>
    <color name="accent_glow_mid">#33AEF23C</color>
    <color name="accent_glow_none">#00AEF23C</color>

    <!-- 아이콘 기본색: Icon(tint=) 로 런타임에 덮어쓰는 벡터의 플레이스홀더 -->
    <color name="icon_tint_base">#FF000000</color>

    <!-- 외부 파트너 브랜드색 (규정색 — 임의 변경 금지) -->
    <color name="kakao_label">#FF191919</color>
    <color name="google_blue">#FF4285F4</color>
    <color name="google_red">#FFEA4335</color>
    <color name="google_green">#FF34A853</color>
    <color name="google_yellow">#FFFBBC05</color>
</resources>
