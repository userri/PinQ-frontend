<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 어댑티브 아이콘 안전 영역은 가운데 72x72.
         100x100 공간에 그린 라임 새싹(sprout)을 0.72 배율로 가운데 배치한다. -->
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <!-- 줄기 (짙은 라임) -->
        <path
            android:pathData="M50,84 L50,50"
            android:strokeColor="@color/grass_2"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
        <!-- 왼쪽 잎 (라임) -->
        <path
            android:fillColor="@color/lime"
            android:pathData="M50,56 C39,58 25,52 20,34 C34,30 48,40 50,56 Z" />
        <!-- 오른쪽 잎 (라임) -->
        <path
            android:fillColor="@color/lime"
            android:pathData="M50,56 C61,58 75,52 80,34 C66,30 52,40 50,56 Z" />
        <!-- 잎맥 (짙은 라임, 얇게) -->
        <path
            android:pathData="M50,56 C46,48 40,42 30,38"
            android:strokeColor="@color/grass_2"
            android:strokeWidth="2"
            android:strokeLineCap="round" />
        <path
            android:pathData="M50,56 C54,48 60,42 70,38"
            android:strokeColor="@color/grass_2"
            android:strokeWidth="2"
            android:strokeLineCap="round" />
    </group>
</vector>
