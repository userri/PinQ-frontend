<?xml version="1.0" encoding="utf-8"?>
<!--
  다시 보기 — 시계 반대 방향 원호 + 화살촉. "앱 소개 다시 보기" 행의 선두 아이콘 시안 A.
  ic_help_circle 과 같은 단색 스트로크(1.6)·24 뷰포트. 색은 tint 로 덮어쓴다.
  원호를 한 바퀴 다 닫지 않는 이유: 닫으면 그냥 원이 되어 "돌아간다"가 사라진다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 열린 원호 — 왼쪽 위가 끊겨 있다 -->
    <path
        android:pathData="M4.2,10.4 a8,8 0 1,1 0.6,5.6"
        android:strokeColor="@color/icon_tint_base"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
    <!-- 끊긴 자리로 되돌아오는 화살촉 -->
    <path
        android:pathData="M8.9,10.1 L4.1,10.4 L4.4,5.6"
        android:strokeColor="@color/icon_tint_base"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
