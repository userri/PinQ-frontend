<?xml version="1.0" encoding="utf-8"?>
<!--
  최고 기록 트로피 — **라임 단색**.

  종전엔 라임 채움에 grass_2(#1E7A42) 외곽선이었다. 그 초록은 네이비 배경(#081A2E)과
  명도차가 작아 20dp 에서 손잡이·기둥·받침이 통째로 사라지고 컵 덩어리만 남았다.
  `docs/ui-rules.md` §3 "다크 배경에 어두운 스트로크 아이콘을 두지 않는다" 그대로다.

  값을 하나만 쓰면 배경이 무엇이든 성립한다 — 런처 아이콘에서 내린 결정과 같은 계열이다
  (중간 톤을 색으로 조절하지 말고 아예 없앤다). 손잡이는 선을 덧대지 않고 **배경이 비치는
  틈**으로 갈린다.

  획 두께 1.5 는 20dp 하한(§3)에서 손잡이가 살아남는 하한이다. 더 가늘면 컵만 남는다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 컵 -->
    <path
        android:fillColor="@color/lime"
        android:pathData="M7.2,3.2 H16.8 V8 A4.8,4.8 0 0,1 7.2,8 Z" />
    <!-- 기둥 -->
    <path
        android:fillColor="@color/lime"
        android:pathData="M11,13.4 h2 v3.4 h-2 z" />
    <!-- 받침 -->
    <path
        android:fillColor="@color/lime"
        android:pathData="M8.6,17.6 H15.4 A1.2,1.2 0 0,1 15.4,20 H8.6 A1.2,1.2 0 0,1 8.6,17.6 Z" />
    <!-- 왼쪽 손잡이 -->
    <path
        android:strokeColor="@color/lime"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M7,5.2 H5.2 A2.9,2.9 0 0,0 7.9,9.6" />
    <!-- 오른쪽 손잡이 -->
    <path
        android:strokeColor="@color/lime"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M17,5.2 H18.8 A2.9,2.9 0 0,1 16.1,9.6" />
</vector>
