        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 오른쪽 면 -->
    <path
        android:pathData="M12,7.2 C13.7,5.9 16,5.3 19.8,5.3 L19.8,17.4 C16,17.4 13.7,18 12,19.3"
        android:strokeColor="@color/icon_tint_base"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 접힘선 -->
    <path
        android:pathData="M12,7.2 L12,19.3"
        android:strokeColor="@color/icon_tint_base"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
</vector>
